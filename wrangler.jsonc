// Szkielet wdrożenia na Cloudflare Workers: pliki statyczne z public/ i małe API w worker/.
// Status: tymczasowe (zob. TYMCZASOWE.md). Nazwa musi zgadzać się z nazwą projektu w Workers Builds.
{
  "name": "jaskinia",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Worker Previews (Wrangler 4.135+): every branch gets its own Preview with these settings. Required, may be empty.
  // Empty on purpose: a Preview has no bindings, no secrets and no data (10 Nov 2026).
  "previews": {}
}
