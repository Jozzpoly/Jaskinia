// Szkielet wdrożenia na Cloudflare Workers: pliki statyczne z public/ i małe API w worker/.
// Status: tymczasowe (zob. TYMCZASOWE.md). Nazwa musi zgadzać się z nazwą projektu w Workers Builds.
{
  "name": "jaskinia",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Miejsce: shared state on the server side, one SQLite Durable Object (step 1 of the core, 15 Nov 2026; taken from
  // the donor branch claude/miejsce-wspolne-2026-11-11; status: proba, TYMCZASOWE.md).
  "durable_objects": { "bindings": [{ "name": "MIEJSCE", "class_name": "Miejsce" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Miejsce"] }],
  // Production has no KLUCZE here: the owner sets them as a secret, and until then Miejsce stays closed.
  // Worker Previews (Wrangler 4.135+): every branch gets its own Preview, and Cloudflare gives each Preview its own
  // Durable Object namespace and storage, so a Preview never touches production state.
  // The Preview keys below are PUBLIC on purpose: anyone can write to a Preview's Miejsce, so nothing private goes
  // there. They let agents and the owner try the whole path without setting a secret.
  // podglad-jozz-klucz-publiczny (owner role), podglad-agent-klucz-publiczny (agent role).
  // Since 17 Nov 2026 the Preview owner is called "probny-wlasciciel", not the real owner's name: agents use this
  // public key for trials, and the journal must not say the real owner did what he did not do.
  // MIEJSCE_NAZWA picks the Durable Object by name: "dom-2" starts a clean Miejsce on existing Previews (the old one
  // stays untouched under "dom"), because the first night's data carried acts signed with the owner's name.
  "previews": {
    "durable_objects": { "bindings": [{ "name": "MIEJSCE", "class_name": "Miejsce" }] },
    "vars": {
      "PODGLAD": "tak",
      // Facts observer (17 Nov 2026): the Durable Object wakes by alarm and pulls public repo facts from GitHub. No token here:
      // the optional GITHUB_DANE_TOKEN is a secret set in Cloudflare, never in this file.
      "OBSERWATOR": "tak",
      // Where the observer may run: beginnings of host names, comma separated. Every branch Preview has its own database, and
      // the first round of facts costs over ten thousand written rows out of the account-wide daily limit (100,000 on
      // the free plan), so it runs only on the trunk Preview and on the branch that builds it.
      "OBSERWATOR_ADRESY": "fable-srodowisko-,fable-automat-faktow-,fable-zywe-,fable-start-",
      // Daily cap of written database rows for one Preview Miejsce. Preview keys are public, so without a cap one looping
      // agent (or a vandal) could spend the whole account's daily write budget through a single Preview.
      "BUDZET_ZAPISOW_NA_DOBE": "25000",
      // Second source (17 Nov 2026): without a token GitHub's API refuses from Cloudflare addresses (403), so the observer
      // falls back to this public facts file. The old Jaskini's automation publishes and refreshes it, usually twice a day;
      // its estate.generated says how old the facts are.
      "OBSERWATOR_BIBLIOTEKA": "https://jozzpoly.github.io/Jozz-Cave-Workbench/dane/library.json",
      // Minutes between wakeups (minimum 5) while the file's branch circle is still being walked; once the circle is closed
      // and nothing changed, the file source waits at least 60 minutes.
      "OBSERWATOR_CO_MIN": "5",
      "WLASCICIEL": "probny-wlasciciel",
      "MIEJSCE_NAZWA": "dom-2",
      // The agent trial key in plain text, shown by /co-tu-jest on Previews only, so a fresh agent can act without
      // being handed anything. It is the same public key whose hash stands in KLUCZE below.
      "KLUCZ_PROBNY_AGENTA": "podglad-agent-klucz-publiczny",
      // The owner trial key in plain text, given to the host page on Previews only (one button: enter as the trial
      // owner), so a hand can try the gestures without typing anything. Same public key as in KLUCZE below.
      "KLUCZ_PROBNY_WLASCICIELA": "podglad-jozz-klucz-publiczny",
      "KLUCZE": "{\"probny-wlasciciel\":\"89db28af24d86977c0b4065bf86cd23f4bb7b92b34ea02323685f8733b45e832\",\"agent-probny\":\"9fcce90d0a08b9b9583f760801ce1a54a452a7cef2e5710234343a1b24ced630\"}"
    }
  }
}
